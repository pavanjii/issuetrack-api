PORT=3000
AUTH_USERNAME=change-me
AUTH_PASSWORD_HASH=paste-a-bcrypt-hash-here
JWT_SECRET=paste-a-long-random-string-here
JWT_EXPIRES_IN=1h
# Number of reverse proxies in front of the app (0 locally; 2 on Render, which sits behind Cloudflare plus Render's proxy. Re-check if the hosting changes)
TRUST_PROXY_HOPS=0